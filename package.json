{
  "name": "starter-sea",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "sea:blob": "node --experimental-sea-config sea-config.json",
    "sea:inject": "node --loader ts-node/esm ./scripts/sea-inject.ts",
    "pkg": "npm run build && npm run sea:blob && npm run sea:inject"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
